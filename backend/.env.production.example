# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=habitus_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=habitus_db

# ── Backend ─────────────────────────────────────────────────────────────────
# DATABASE_URL di-override oleh docker-compose.prod.yml (pakai POSTGRES_* di atas)
# Tidak perlu diset di sini jika pakai docker-compose.prod.yml
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MIN_32_KARAKTER
JWT_EXPIRES_IN=24h
CORS_ORIGIN=https://habitus.ramadhaninursarjito.tech
NODE_ENV=production
MAX_ACTIVE_LOANS=3
LOAN_DURATION_DAYS=14
FINE_PER_DAY=1000

# ── Frontend build arg (baked saat docker build) ────────────────────────────
NEXT_PUBLIC_API_URL=https://habitus-api.ramadhaninursarjito.tech/api/v1
