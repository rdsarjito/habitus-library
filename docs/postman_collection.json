{
  "info": {
    "name": "Library Management System API",
    "_postman_id": "habitus-library-api-v1",
    "description": "REST API for managing library books, members, and loan transactions.\n\n**Base URL (Production):** https://habitus-api.ramadhaninursarjito.tech/api/v1\n**Swagger UI:** https://habitus-api.ramadhaninursarjito.tech/api/docs\n\n## Setup\n1. Login via `POST /auth/login` to get a JWT token\n2. Copy the token from the response\n3. Set the `token` variable in the collection variables\n4. All protected endpoints will automatically use it via `Bearer {{token}}`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://habitus-api.ramadhaninursarjito.tech/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "A. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data?.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login dengan username dan password. Token JWT otomatis tersimpan ke collection variable `token`."
          },
          "response": [
            {
              "name": "Login Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login berhasil\",\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIs...\",\n    \"user\": {\n      \"id\": \"uuid\",\n      \"username\": \"admin\",\n      \"role\": \"STAFF\"\n    }\n  }\n}"
            },
            {
              "name": "Invalid Credentials",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Username atau password salah\",\n  \"errors\": [\n    {\n      \"code\": \"INVALID_CREDENTIALS\",\n      \"message\": \"Username atau password salah\"\n    }\n  ]\n}"
            },
            {
              "name": "Validation Error",
