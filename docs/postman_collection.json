                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Validasi gagal\",\n  \"errors\": [\n    {\n      \"code\": \"VALIDATION_ERROR\",\n      \"field\": \"username\",\n      \"message\": \"Username wajib diisi\"\n    }\n  ]\n}"
            }
          ]
        },
